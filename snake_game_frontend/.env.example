# Frontend environment example for CRA

# Base URLs (optional). If unset, analytics network calls are no-ops.
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime environment
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_HEALTHCHECK_PATH=/healthz

# Logging verbosity: error | warn | info | debug
REACT_APP_LOG_LEVEL=info

# Telemetry controls
# When "true" (default), network telemetry is disabled. Set "false" to enable.
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Feature flags: JSON or comma-separated list (key:value or names as true)
# Examples:
# REACT_APP_FEATURE_FLAGS={"showGridLines":true,"emitTickEvents":false}
# REACT_APP_FEATURE_FLAGS=showGridLines:true,emitTickEvents:false
REACT_APP_FEATURE_FLAGS=

# Experiments: "true" to enable, defaults to false if unset/invalid
REACT_APP_EXPERIMENTS_ENABLED=false
